{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "examples/generator",
    "examples/order-cancel.generated/cancellation-terms.ts",
    "examples/order-cancel.generated/cancellation-terms.test.ts"
  ]
}
